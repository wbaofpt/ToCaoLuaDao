{
  "name": "tocaoluadao",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "concurrently \"npm run start:api\" \"npm run preview -- --host 0.0.0.0\"",
    "start:api": "tsx server/index.ts",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "concurrently": "latest",
    "cors": "latest",
    "dotenv": "^18.0.1",
    "express": "latest",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "latest",
    "nodemailer": "^10.0.10",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
